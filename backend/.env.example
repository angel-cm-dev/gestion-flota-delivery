# Copia este archivo como backend/.env para desarrollo SIN Docker.
ENVIRONMENT=development
# Opción A (más simple): SQLite local
DATABASE_URL=sqlite:///./flota-dev.db
# Opción B: PostgreSQL local
# DATABASE_URL=postgresql+psycopg://flota:flota_dev_password@localhost:5432/flota
JWT_SECRET=dev-secret-cambiar-en-produccion-minimo-32-caracteres
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173
DEPOT_LAT=-12.0464
DEPOT_LNG=-77.0428
UPLOAD_DIR=./uploads
LOG_JSON=false
