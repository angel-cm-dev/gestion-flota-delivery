# Variables para docker-compose. Copia como .env y cambia los valores.
# VALORES DE EJEMPLO: no uses estos secretos en producción.

POSTGRES_DB=flota
POSTGRES_USER=flota
POSTGRES_PASSWORD=flota_dev_password

ENVIRONMENT=production
# Genera una clave larga y aleatoria, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esta-clave-en-produccion-minimo-32-caracteres
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:8080

# Depósito central (Cercado de Lima)
DEPOT_LAT=-12.0464
DEPOT_LNG=-77.0428

# Siembra datos ficticios de demostración al arrancar (idempotente)
SEED_DEMO_DATA=true

API_PORT=8000
WEB_PORT=8080
